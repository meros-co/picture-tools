// Generated by picture-tools-gen from shaders/picture_tools.glsl.in and the
// uniform table in crates/picture-tools/src/tools.rs. Don't edit; regenerate.
// Metal: picture_tools_vertex draws a full-screen triangle and
// picture_tools_fragment the tools. Uniforms at buffer 0, the picture at
// texture 0, the LUT atlas at texture 1 (bind any texture there when the
// LUT is off: it isn't sampled).
#include <metal_stdlib>
using namespace metal;

// The plain uniforms, packed: exactly the floats `mpt_uniforms` writes, in
// order (see shaders/uniforms.json).
struct MptUniforms {
  packed_float2 u_size;
  float u_time;
  float u_range;
  packed_float3 u_luma;
  float u_lut;
  float u_lut_size;
  float u_fc;
  float u_fc_outside;
  float u_fc_count;
  float u_fc_lo[8];
  float u_fc_hi[8];
  packed_float3 u_fc_rgb[8];
  float u_zebra_count;
  float u_zebra_level[2];
  float u_zebra_band[2];
  float u_zebra_stripe;
  float u_zebra_speed;
  float u_zebra_style;
  float u_peak;
  packed_float3 u_peak_color;
};

struct MptVertexOut {
  float4 position [[position]];
};

vertex MptVertexOut picture_tools_vertex(uint vid [[vertex_id]]) {
  float2 p = float2(float((vid << 1) & 2), float(vid & 2));
  MptVertexOut out;
  out.position = float4(p * 2.0 - 1.0, 0.0, 1.0);
  return out;
}

inline float mpt_mod(float x, float y) {
  return x - y * floor(x / y);
}

float2 mpt_uv(float2 frag, constant MptUniforms& u, texture2d<float> u_input, texture2d<float> u_lut_tex, sampler smp) {
  return frag / float2(u.u_size);
}

// The 3D LUT from its atlas: x = blue slice × N + red, y = green. Red and
// green interpolate in the texture sampler, blue between the two slices.
float3 mpt_lut(float3 c, constant MptUniforms& u, texture2d<float> u_input, texture2d<float> u_lut_tex, sampler smp) {
  float n = u.u_lut_size;
  float3 x = clamp(c, float3(0.0), float3(1.0)) * (n - 1.0);
  float b0 = floor(x.b);
  float b1 = min(b0 + 1.0, n - 1.0);
  float f = x.b - b0;
  float2 rg = float2(x.r + 0.5, x.g + 0.5);
  float3 s0 = u_lut_tex.sample(smp, float2((b0 * n + rg.x) / (n * n), rg.y / n)).rgb;
  float3 s1 = u_lut_tex.sample(smp, float2((b1 * n + rg.x) / (n * n), rg.y / n)).rgb;
  return mix(s0, s1, float3(f));
}

// The picture at a pixel: the input, through the LUT when it's on. The
// LUT texture isn't touched when it's off, so it may be left unbound.
float3 mpt_picture(float2 frag, constant MptUniforms& u, texture2d<float> u_input, texture2d<float> u_lut_tex, sampler smp) {
  float3 c = u_input.sample(smp, mpt_uv(frag, u, u_input, u_lut_tex, smp)).rgb;
  if (u.u_lut > 0.5) {
    c = mpt_lut(c, u, u_input, u_lut_tex, smp);
  }
  return c;
}

// Luma for measuring: limited-range input expanded to full range first.
float mpt_luma(float3 c, constant MptUniforms& u, texture2d<float> u_input, texture2d<float> u_lut_tex, sampler smp) {
  float3 v = c;
  if (u.u_range > 0.5) {
    v = (c - 16.0 / 255.0) * (255.0 / 219.0);
  }
  return dot(v, float3(u.u_luma));
}

float4 mpt_shade(float2 frag, constant MptUniforms& u, texture2d<float> u_input, texture2d<float> u_lut_tex, sampler smp) {
  float3 c = mpt_picture(frag, u, u_input, u_lut_tex, smp);
  float y = mpt_luma(c, u, u_input, u_lut_tex, smp);
  float3 o = c;

  // False color: the first band holding the luma, else the picture or its
  // luma in gray.
  if (u.u_fc > 0.5) {
    bool found = false;
    float3 band = float3(y);
    for (int i = 0; i < 8; i++) {
      if (float(i) >= u.u_fc_count) break;
      if (!found && y >= u.u_fc_lo[i] && y < u.u_fc_hi[i]) {
        band = float3(u.u_fc_rgb[i]);
        found = true;
      }
    }
    if (found) {
      o = band;
    } else if (u.u_fc_outside > 0.5) {
      o = float3(y);
    }
  }

  // Zebras: still black-and-white stripes mixed in (the first on one
  // diagonal at 60%, the second on the other at 50%), or dark stripes that
  // move along the diagonal.
  float stripe = max(u.u_zebra_stripe, 1.0);
  float period = 2.0 * stripe;
  for (int k = 0; k < 2; k++) {
    if (float(k) >= u.u_zebra_count) break;
    float level = u.u_zebra_level[k];
    float half_band = u.u_zebra_band[k];
    bool hit = half_band > 0.0 ? abs(y - level) <= half_band : y >= level;
    if (hit) {
      if (u.u_zebra_style < 0.5) {
        float along = k == 0 ? frag.x + frag.y : frag.x - frag.y;
        float s = mpt_mod(along, period) < stripe ? 1.0 : 0.0;
        o = mix(o, float3(s), float3(k == 0 ? 0.6 : 0.5));
      } else {
        float along = k == 0 ? frag.x - frag.y + float2(u.u_size).y : frag.x + frag.y;
        if (mpt_mod(along + u.u_time * u.u_zebra_speed, period) < stripe) {
          o = float3(0.06);
        }
      }
    }
  }

  // Focus peaking: the luma Laplacian over the four neighbors.
  if (u.u_peak > 0.0) {
    float left = mpt_luma(mpt_picture(frag + float2(-1.0, 0.0), u, u_input, u_lut_tex, smp), u, u_input, u_lut_tex, smp);
    float right = mpt_luma(mpt_picture(frag + float2(1.0, 0.0), u, u_input, u_lut_tex, smp), u, u_input, u_lut_tex, smp);
    float up = mpt_luma(mpt_picture(frag + float2(0.0, -1.0), u, u_input, u_lut_tex, smp), u, u_input, u_lut_tex, smp);
    float down = mpt_luma(mpt_picture(frag + float2(0.0, 1.0), u, u_input, u_lut_tex, smp), u, u_input, u_lut_tex, smp);
    if (abs(4.0 * y - left - right - up - down) > u.u_peak) {
      o = float3(u.u_peak_color);
    }
  }
  return float4(clamp(o, float3(0.0), float3(1.0)), 1.0);
}

fragment float4 picture_tools_fragment(
    MptVertexOut in [[stage_in]],
    constant MptUniforms& u [[buffer(0)]],
    texture2d<float> u_input [[texture(0)]],
    texture2d<float> u_lut_tex [[texture(1)]]) {
  constexpr sampler smp(address::clamp_to_edge, filter::linear);
  return mpt_shade(in.position.xy, u, u_input, u_lut_tex, smp);
}
