// The picture tools, per pixel: a LUT, false color, zebras and focus
// peaking. The one source for every dialect; `cargo run -p
// picture-tools-gen` writes shaders/gen/ from it and from the uniform table
// in crates/picture-tools/src/tools.rs. The CPU reference (`apply_cpu`)
// does the same arithmetic.
//
// Written in a GLSL subset the generator maps to each dialect:
//   U.name          a uniform (`name` in GLSL, `u.name` in Metal)
//   SAMPLE_INPUT    the picture at a texture coordinate
//   SAMPLE_LUT      the LUT atlas at a texture coordinate
//   mpt_mod         GLSL's mod (Metal's fmod truncates)
//   MPT_ARGS        extra parameters a function needs in Metal; MPT_PASS
//                   passes them on
// `frag` is the output pixel's center, origin top left, in every dialect;
// `mpt_uv(frag)` is where the picture is sampled for it.

// The 3D LUT from its atlas: x = blue slice × N + red, y = green. Red and
// green interpolate in the texture sampler, blue between the two slices.
vec3 mpt_lut(vec3 c MPT_ARGS) {
  float n = U.u_lut_size;
  vec3 x = clamp(c, vec3(0.0), vec3(1.0)) * (n - 1.0);
  float b0 = floor(x.b);
  float b1 = min(b0 + 1.0, n - 1.0);
  float f = x.b - b0;
  vec2 rg = vec2(x.r + 0.5, x.g + 0.5);
  vec3 s0 = SAMPLE_LUT(vec2((b0 * n + rg.x) / (n * n), rg.y / n)).rgb;
  vec3 s1 = SAMPLE_LUT(vec2((b1 * n + rg.x) / (n * n), rg.y / n)).rgb;
  return mix(s0, s1, vec3(f));
}

// The picture at a pixel: the input, through the LUT when it's on. The
// LUT texture isn't touched when it's off, so it may be left unbound.
vec3 mpt_picture(vec2 frag MPT_ARGS) {
  vec3 c = SAMPLE_INPUT(mpt_uv(frag MPT_PASS)).rgb;
  if (U.u_lut > 0.5) {
    c = mpt_lut(c MPT_PASS);
  }
  return c;
}

// Luma for measuring: limited-range input expanded to full range first.
float mpt_luma(vec3 c MPT_ARGS) {
  vec3 v = c;
  if (U.u_range > 0.5) {
    v = (c - 16.0 / 255.0) * (255.0 / 219.0);
  }
  return dot(v, U.u_luma);
}

vec4 mpt_shade(vec2 frag MPT_ARGS) {
  vec3 c = mpt_picture(frag MPT_PASS);
  float y = mpt_luma(c MPT_PASS);
  vec3 o = c;

  // False color: the first band holding the luma, else the picture or its
  // luma in gray.
  if (U.u_fc > 0.5) {
    bool found = false;
    vec3 band = vec3(y);
    for (int i = 0; i < 8; i++) {
      if (float(i) >= U.u_fc_count) break;
      if (!found && y >= U.u_fc_lo[i] && y < U.u_fc_hi[i]) {
        band = U.u_fc_rgb[i];
        found = true;
      }
    }
    if (found) {
      o = band;
    } else if (U.u_fc_outside > 0.5) {
      o = vec3(y);
    }
  }

  // Zebras: still black-and-white stripes mixed in (the first on one
  // diagonal at 60%, the second on the other at 50%), or dark stripes that
  // move along the diagonal.
  float stripe = max(U.u_zebra_stripe, 1.0);
  float period = 2.0 * stripe;
  for (int k = 0; k < 2; k++) {
    if (float(k) >= U.u_zebra_count) break;
    float level = U.u_zebra_level[k];
    float half_band = U.u_zebra_band[k];
    bool hit = half_band > 0.0 ? abs(y - level) <= half_band : y >= level;
    if (hit) {
      if (U.u_zebra_style < 0.5) {
        float along = k == 0 ? frag.x + frag.y : frag.x - frag.y;
        float s = mpt_mod(along, period) < stripe ? 1.0 : 0.0;
        o = mix(o, vec3(s), vec3(k == 0 ? 0.6 : 0.5));
      } else {
        float along = k == 0 ? frag.x - frag.y + U.u_size.y : frag.x + frag.y;
        if (mpt_mod(along + U.u_time * U.u_zebra_speed, period) < stripe) {
          o = vec3(0.06);
        }
      }
    }
  }

  // Focus peaking: the luma Laplacian over the four neighbors.
  if (U.u_peak > 0.0) {
    float left = mpt_luma(mpt_picture(frag + vec2(-1.0, 0.0) MPT_PASS) MPT_PASS);
    float right = mpt_luma(mpt_picture(frag + vec2(1.0, 0.0) MPT_PASS) MPT_PASS);
    float up = mpt_luma(mpt_picture(frag + vec2(0.0, -1.0) MPT_PASS) MPT_PASS);
    float down = mpt_luma(mpt_picture(frag + vec2(0.0, 1.0) MPT_PASS) MPT_PASS);
    if (abs(4.0 * y - left - right - up - down) > U.u_peak) {
      o = U.u_peak_color;
    }
  }
  return vec4(clamp(o, vec3(0.0), vec3(1.0)), 1.0);
}
