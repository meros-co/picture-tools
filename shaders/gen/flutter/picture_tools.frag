uniform float u_time; // time, for animated zebras (s)
uniform float u_range; // 0 full range, 1 limited (16-235)
uniform vec3 u_luma; // luma weights
uniform float u_lut; // 1 to apply the LUT
uniform float u_lut_size; // N, for an N³ LUT
uniform float u_fc; // 1 for false color
uniform float u_fc_outside; // outside the bands: 0 the picture, 1 grayscale luma
