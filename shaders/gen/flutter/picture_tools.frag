  vec3 x = clamp(c, vec3(0.0), vec3(1.0)) * (n - 1.0);
  float b0 = floor(x.b);
  float b1 = min(b0 + 1.0, n - 1.0);
  float f = x.b - b0;
  vec2 rg = vec2(x.r + 0.5, x.g + 0.5);
  vec3 s0 = texture(u_lut_tex, vec2((b0 * n + rg.x) / (n * n), rg.y / n)).rgb;
  vec3 s1 = texture(u_lut_tex, vec2((b1 * n + rg.x) / (n * n), rg.y / n)).rgb;
