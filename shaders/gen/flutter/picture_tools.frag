uniform float u_fc_lo[8]; // band starts (inclusive) (luma)
uniform float u_fc_hi[8]; // band ends (exclusive) (luma)
uniform vec3 u_fc_rgb[8]; // band colors
uniform float u_zebra_count; // zebras in use
uniform float u_zebra_level[2]; // zebra levels, 0-1.09 (luma)
uniform float u_zebra_band[2]; // half-width of a zebra's band; 0 for at or above its level (luma)
uniform float u_zebra_stripe; // stripe width (px)
